# Schwab API Configuration Template
# Copy this file to .env and fill in your credentials

# Get these from: https://developer.schwab.com/
SCHWAB_APP_KEY="YOUR_APP_KEY_HERE"
SCHWAB_APP_SECRET="YOUR_APP_SECRET_HERE"
SCHWAB_CALLBACK_URL="https://127.0.0.1:5001"

# Instructions:
# 1. Go to https://developer.schwab.com/
# 2. Create a developer account
# 3. Create a new app to get your APP_KEY and APP_SECRET
# 4. Copy this file to .env
# 5. Replace YOUR_APP_KEY_HERE and YOUR_APP_SECRET_HERE with your actual credentials
# 6. Keep the callback URL as is (https://127.0.0.1:5001)
